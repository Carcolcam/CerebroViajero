}\r\n        .pulsepromo {background-color: #F5F5F5;}\r\n        .pulsepromo__badge {width: 119px; height: 35px;}\r\n        @media only screen and (min-width: 480px ) {\r\n        body[body] .mobilecontent{display: table-cell !important; max-height: none !important;}\r\n        .booking-details {text-align: right;}\r\n        .message__legal {padding: 0 0 16px;}\r\n        }\r\n        @media only screen and (max-width: 479px ) {\r\n        body[body] .m-hide{width:0;display:none!important;}\r\n        body[body] .m-show{display:block!important;}\r\n        body[body] .deviceWidth{width:95%!important;padding:0!important;}\r\n        body[body] .m-100p {width:100%!important;padding:0!important;}\r\n        body[body] .m-50p{width:49%!important;padding:0!important;}\r\n        .header td {display: block;}\r\n        .m-100p {width:90%!important;padding:0!important;}\r\n        .m-centre {float: none !important; text-align: center !important;}\r\n        .m-left {float: none !important; text-align: left !important; padding-top:20px !important;}\r\n        .m-right {float: none !important; text-align: right !important;}\r\n        .m-small {font-size: 16px !important; line-height: 20px !important;}\r\n        .m-pull-left {float:none !important; text-align: left !important;}\r\n        }*/\r\n    </style>\r\n</head>\r\n<body class=\"body\" bgcolor=\"#FFFFFF\" topmargin=\"0\" leftmargin=\"0\" marginwidth=\"0\" marginheight=\"0\" style=\"font-family:BlinkMacSystemFont, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;font-size: 14px;line-height: 20px;font-weight: 400;background-color: #FFFFFF;width: 100%;\">\r\n<!--[if mso]>\r\n<style type=\"text/css\">\r\n    body, table, td {\r\n        font-family: Arial, Helvetica, sans-serif !important;\r\n    }\r\n</style>\r\n<![endif]-->\r\n<table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\">\r\n    <!-- Gmail min-width hack -->\r\n    <div class=\"Gmail\" style=\"height: 1px !important; margin-top: -1px !important; max-width: 420 !important; min-width: 420 !important; width: 420 !important;\"></div>\r\n    <tr>\r\n        <td>\r\n            <!-- Ghost table -->\r\n            <!--[if (gte mso 9)|(IE)]>\r\n            <table width=\"420\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\">\r\n                <tr>\r\n                    <td>\r\n            <![endif]-->\r\n            <table class=\"container-table\" lang=\"container-table\" width=\"420\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" align=\"center\" style=\"margin-left: auto; margin-right: auto; max-width: 420px; width: 420px; -webkit-font-smoothing: antialiased; -moz-font-smoothing: grayscale;\">\r\n                <tr>\r\n                    <td>\r\n                        <!-- Place all content within this <td> -->\r\n                        <table bgcolor=\"#00224F\" width=\"420\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px; border-bottom: 1px solid #E6E6E6; color: #FFFFFF;\">\r\n                            <tr>\r\n                                <td bgcolor=\"#00224F\" style=\"padding-left: 20px; padding-top: 10px; padding-bottom: 10px; background-color: #00224F;\">\r\n                                    <img width=\"130\" src=\"https://r-xx.bstatic.com/static/img/mean/logo_white.png\" border=\"0\" alt=\"booking.com\" style=\"display: block; margin: 0; padding: 0; width: 130px;\">\r\n                                </td>\r\n                                <td style=\"padding-right: 20px; padding-top: 10px; padding-bottom: 10px; background-color: #00224F;\">\r\n                                    <p style=\"font-size: 14px;line-height: 20px;font-weight: 400;margin: 0; padding: 0; text-align: right; color: #FFFFFF;\">\r\n                                        Número de confirmación:\r\n                                        <a href=\"https://secure.booking.com/myreservations.html?bn=6686598018\" style=\"cursor: pointer;color: #0071C2;display: inline-block;\">\r\n                                            6686598018\r\n                                        </a>\r\n                                    </p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <table width=\"420\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px;\">\r\n                            <tr>\r\n                                <td style=\"font-size: 24px;line-height: 32px;font-weight: 600; font-weight: 700; text-align: center; color: #333333; padding-top: 50px; padding-left: 80px; padding-right: 80px; padding-bottom: 50px;\">\r\n                                    Tienes un mensaje nuevo de The Pulisan\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!--start guest name sent: -->\r\n                        <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                            <tr>\r\n                                <td style=\"padding-left: 20px; padding-bottom: 10px; padding-right: 20px; text-align: left;\">\r\n                                    <p style=\"font-size: 16px;line-height: 24px;font-weight: 500;display: block;margin: 0;padding: 0; font-weight: 600; color: #333333;\">\r\n                                        Esto es lo que han dicho:\r\n                                    </p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!--end guest name sent: -->\r\n                        <table width=\"420\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px;\">\r\n                            <tr>\r\n                                <td style=\"padding-left: 10px;\">\r\n                                    <img src=\"http://r.bstatic.com/static/img/messaging/speechbubble_arrow.png\" width=\"10\" alt=\"\" style=\"display: block; margin: 0; padding: 0; width: 10px;\">\r\n                                </td>\r\n                                <td width=\"100%\" style=\"padding-right: 20px; padding-bottom: 10px;\">\r\n                                    <table width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td bgcolor=\"#E6E6E6\" style=\"padding: 16px; margin: 0; background-color: #E6E6E6;font-size: 16px;line-height: 24px;font-weight: 400;color: #000000;border-top-left-radius: 8px; border-top-right-radius: 8px;border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;\">\r\n                                                <span>Dear Mr. Carlos Collado,<br><br>Greetings from The Pulisan.<br><br>Thank you for your reservation.<br><br>In response to your inquiry about the payment method, you may settle any additional expenses in cash upon check-out. However, for the room booking made through Booking.com, please ensure that payment is completed through their platform.<br><br>If you have any further questions, feel free to ask.<br><br>Best regards,<br><br>The Pulisan<br></span>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <table width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                            <tbody>\r\n                            <tr>\r\n                                <td style=\"padding: 20px;\">\r\n                                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #0071C2;border-radius:4px;-webkit-text-size-adjust:none;color:#FFFFFF;border: 2px solid #0071C2;\">\r\n                                        <tbody>\r\n                                        <tr>\r\n                                            <td style=\"color: #FFFFFF;font-size: 14px;font-weight: 700;text-align: center;text-decoration:none;padding: 10px;\">\r\n                                                <a target=\"_blank\" href=\"https://secure.booking.com/inbox/partner-chat?vertical=accommodation&amp;external_id=6686598018&amp;bn=6686598018&amp;product=post_booking&amp;source=email&amp;channel=partner_chat&amp;opened_from_source=wakeup_email\" alt=\"https://secure.booking.com/inbox/partner-chat?vertical=accommodation&amp;external_id=6686598018&amp;bn=6686598018&amp;product=post_booking&amp;source=email&amp;channel=partner_chat&amp;opened_from_source=wakeup_email\" style=\"color: #FFFFFF;font-size: 14px;font-weight: 700;text-align: center;padding: 10px;text-decoration:none;cursor: pointer;\">Ver mensajes</a>\r\n                                            </td>\r\n                                        </tr>\r\n                                        </tbody>\r\n                                    </table>\r\n                                </td>\r\n                            </tr>\r\n                            </tbody>\r\n                        </table>\r\n                        <!--start-->\r\n                        <table width=\"420\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px; border-top: 1px solid #E6E6E6;\">\r\n                            <!--RESERVATION DETAILS-->\r\n                            <tr>\r\n                                <td>\r\n                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B; padding: 20px;\">\r\n                                                <p style=\"font-size: 16px;line-height: 24px;font-weight: 500; margin: 0; color: #6B6B6B; font-weight: bold;\">\r\n                                                    Datos de la reserva\r\n                                                </p>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"padding-left: 20px; padding-bottom: 20px; padding-right: 20px;\">\r\n                                                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                                    <tr>\r\n                                                        <td width=\"50%\" style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B;\">\r\n                                                            <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                                Check-in:\r\n                                                                <br>\r\n                                                                <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">Tue 8 Sep 2026</span>\r\n                                                            </p>\r\n                                                        </td>\r\n                                                        <td width=\"50%\" style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B;\">\r\n                                                            <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                                Check-out:\r\n                                                                <br>\r\n                                                                <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">Fri 11 Sep 2026</span>\r\n                                                            </p>\r\n                                                        </td>\r\n                                                    </tr>\r\n                                                </table>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B; padding: 0 20px 20px;\">\r\n                                                <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                    Nombre del establecimiento:\r\n                                                    <br>\r\n                                                    <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">\r\n                                                        <a href=\"https://www.booking.com/hotel/id/the-pulisan.html\" style=\"font-size: 16px;line-height: 24px;font-weight: 500;cursor: pointer;color: #0071C2; text-decoration: none;\">\r\n                                                        The Pulisan</a>\r\n                                                    </span>\r\n                                                </p>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"font-size: 14px;line-height: 20px;font-weight: 400;color: #6B6B6B; padding: 0 20px 20px;\">\r\n                                                <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                    Número de reserva:\r\n                                                    <br>\r\n                                                    <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">\r\n                                                        <a href=\"https://secure.booking.com/myreservations.html?bn=6686598018\" style=\"font-size: 16px;line-height: 24px;font-weight: 500;cursor: pointer;color: #0071C2; text-decoration: none;\">\r\n                                                        6686598018</a>\r\n                                                    </span>\r\n                                                </p>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!--end-->\r\n                        <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px; color: #000000; border-top: 1px solid #E6E6E6;\">\r\n                            <tr>\r\n                                <td align=\"center\" style=\"padding: 20px;\">\r\n                                    <p style=\"display: block;margin: 0;padding: 0; font-size: 12px;\">\r\n                                        © Copyright <a style=\"color:#0071C2;\" href=\"https://www.booking.com?source=p2g_email\">Booking.com</a> 2026<br>Este e-mail ha sido enviado por <a style=\"color:#0071C2;\" href=\"https://www.booking.com?source=p2g_email\">Booking.com</a></p>\r\n                                </td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td style=\"padding: 30px; text-align: center; font-size: 12px;\">\r\n                                    <p style=\"display: block;margin: 0;padding: 0;\">Booking.com recibirá y procesará las respuestas a este e-mail según se establece en la <a style=\"cursor: pointer;color: #0071C2;\" href=\"https://www.booking.com/content/privacy.html?label=gen000nr-10EiBteWJvb2tpbmdtZ19yZXF1ZXN0X2NvbmZpcm1hdGlvbiiCAkICWFhIMVgEcgJ4eIgBAZgBM7gBBcgBBdgBA-gBAfgBAZICAXmoAgE\">Política de privacidad de Booking.com</a>. Booking.com no ha generado el contenido del mensaje de The Pulisan, por lo que no se hace responsable del contenido del mismo.</p>\r\n                                </td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td style=\"text-align: center;\">\r\n                                    <a style=\"cursor: pointer;color: #0071C2;\" href=\"https://secure.booking.com/faq.html?faq_item=item_communication\">\r\n                                        ¿Por qué he recibido este mensaje?\r\n                                    </a>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!-- Place all content before this <td> -->\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n            <!--[if (gte mso 9)|(IE)]>\r\n            </td>\r\n            </tr>\r\n            </table>\r\n            <![endif]-->\r\n        </td>\r\n    </tr>\r\n</table>\r\n<!-- prevent Gmail on iOS font size manipulation -->\r\n<div style=\"display:none; white-space:nowrap; font:15px courier; line-height:0;\"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\r\n    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\r\n    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\r\n</div>\r\n</body>\r\n</html>\r\n"
    }
]