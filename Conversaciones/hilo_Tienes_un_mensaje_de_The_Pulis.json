: inline-block;\">\r\n                                            6686598018\r\n                                        </a>\r\n                                    </p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <table width=\"420\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px;\">\r\n                            <tr>\r\n                                <td style=\"font-size: 24px;line-height: 32px;font-weight: 600; font-weight: 700; text-align: center; color: #333333; padding-top: 50px; padding-left: 80px; padding-right: 80px; padding-bottom: 50px;\">\r\n                                    Tienes un mensaje nuevo de The Pulisan\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!--start guest name sent: -->\r\n                        <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                            <tr>\r\n                                <td style=\"padding-left: 20px; padding-bottom: 10px; padding-right: 20px; text-align: left;\">\r\n                                    <p style=\"font-size: 16px;line-height: 24px;font-weight: 500;display: block;margin: 0;padding: 0; font-weight: 600; color: #333333;\">\r\n                                        Esto es lo que han dicho:\r\n                                    </p>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <!--end guest name sent: -->\r\n                        <table width=\"420\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px;\">\r\n                            <tr>\r\n                                <td style=\"padding-left: 10px;\">\r\n                                    <img src=\"http://r.bstatic.com/static/img/messaging/speechbubble_arrow.png\" width=\"10\" alt=\"\" style=\"display: block; margin: 0; padding: 0; width: 10px;\">\r\n                                </td>\r\n                                <td width=\"100%\" style=\"padding-right: 20px; padding-bottom: 10px;\">\r\n                                    <table width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td bgcolor=\"#E6E6E6\" style=\"padding: 16px; margin: 0; background-color: #E6E6E6;font-size: 16px;line-height: 24px;font-weight: 400;color: #000000;border-top-left-radius: 8px; border-top-right-radius: 8px;border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;\">\r\n                                                <span>Dear Mr. Carlos Collado,<br><br>Greetings from The Pulisan.<br><br>Thank you for your reservation.<br><br>In response to your inquiry about the payment method, you may settle any additional expenses in cash upon check-out. However, for the room booking made through Booking.com, please ensure that payment is completed through their platform.<br><br>If you have any further questions, feel free to ask.<br><br>Best regards,<br><br>The Pulisan<br></span>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                        <table width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                            <tbody>\r\n                            <tr>\r\n                                <td style=\"padding: 20px;\">\r\n                                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #0071C2;border-radius:4px;-webkit-text-size-adjust:none;color:#FFFFFF;border: 2px solid #0071C2;\">\r\n                                        <tbody>\r\n                                        <tr>\r\n                                            <td style=\"color: #FFFFFF;font-size: 14px;font-weight: 700;text-align: center;text-decoration:none;padding: 10px;\">\r\n                                                <a target=\"_blank\" href=\"https://secure.booking.com/inbox/partner-chat?vertical=accommodation&amp;external_id=6686598018&amp;bn=6686598018&amp;product=post_booking&amp;source=email&amp;channel=partner_chat&amp;opened_from_source=wakeup_email\" alt=\"https://secure.booking.com/inbox/partner-chat?vertical=accommodation&amp;external_id=6686598018&amp;bn=6686598018&amp;product=post_booking&amp;source=email&amp;channel=partner_chat&amp;opened_from_source=wakeup_email\" style=\"color: #FFFFFF;font-size: 14px;font-weight: 700;text-align: center;padding: 10px;text-decoration:none;cursor: pointer;\">Ver mensajes</a>\r\n                                            </td>\r\n                                        </tr>\r\n                                        </tbody>\r\n                                    </table>\r\n                                </td>\r\n                            </tr>\r\n                            </tbody>\r\n                        </table>\r\n                        <!--start-->\r\n                        <table width=\"420\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width: 420px; border-top: 1px solid #E6E6E6;\">\r\n                            <!--RESERVATION DETAILS-->\r\n                            <tr>\r\n                                <td>\r\n                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B; padding: 20px;\">\r\n                                                <p style=\"font-size: 16px;line-height: 24px;font-weight: 500; margin: 0; color: #6B6B6B; font-weight: bold;\">\r\n                                                    Datos de la reserva\r\n                                                </p>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"padding-left: 20px; padding-bottom: 20px; padding-right: 20px;\">\r\n                                                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\r\n                                                    <tr>\r\n                                                        <td width=\"50%\" style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B;\">\r\n                                                            <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                                Check-in:\r\n                                                                <br>\r\n                                                                <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">Tue 8 Sep 2026</span>\r\n                                                            </p>\r\n                                                        </td>\r\n                                                        <td width=\"50%\" style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B;\">\r\n                                                            <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                                Check-out:\r\n                                                                <br>\r\n                                                                <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">Fri 11 Sep 2026</span>\r\n                                                            </p>\r\n                                                        </td>\r\n                                                    </tr>\r\n                                                </table>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n                                        <tr>\r\n                                            <td style=\"font-size: 14px;line-height: 20px;font-weight: 400; color: #6B6B6B; padding: 0 20px 20px;\">\r\n                                                <p style=\"display: block;margin: 0;padding: 0;\">\r\n                                                    Nombre del establecimiento:\r\n                                                    <br>\r\n                                                    <span style=\"display: block;margin: 0;padding: 0;font-size: 16px;line-height: 24px;font-weight: 500;\">\r\n                                                        <a href=\"https://www.booking.com/hotel/id/the-pulisan.html\" style=\"font-size: 16px;line-height: 24px;font-weight: 500;cursor: pointer;color: #0071C2; text-decoration: none;\">\r\n                                                        The Pulisan</a>\r\n                                                    </span>\r\n                                                </p>\r\n                                            </td>\r\n                                        </tr>\r\n                                    </table>\r\n                                    <table width=\"100%\" cellspacing=\"0\" cellpadding=